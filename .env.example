# Subdomain publik server ini (A record -> IP statis VM)
DOMAIN=ingest.nirbatas.id
# Email untuk notifikasi Let's Encrypt (opsional tapi disarankan)
ACME_EMAIL=

# Koneksi aplikasi: role smile_ingest lewat Supavisor SESSION pooler (port 5432).
# Salin host persisnya dari Supabase Dashboard > Connect > Session pooler
# (awalan aws-0 / aws-1 tidak bisa ditebak dari region).
# Password yang mengandung karakter khusus harus di-URL-encode.
DATABASE_URL=postgresql://smile_ingest.rlzoixdjpzloemnternu:GANTI_PASSWORD@aws-X-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# 100 untuk session pooler (5432). WAJIB 0 kalau memakai transaction pooler (6543).
DB_STATEMENT_CACHE_SIZE=100

LOG_LEVEL=INFO

# Dispatcher mode auto (v8). Lihat README bagian "Kanal aktuator".
DISPATCHER_ENABLED=1
DISPATCH_INTERVAL_S=60
# Keputusan tim (kontrak §9 no. 6). Kosong = executed_by NULL, fertigasi auto mati.
FERTIGATION_EXECUTED_BY=
FERTIGATION_AUTO_STATUSES=

# Neraca air FAO-56 (v11). Lihat README bagian "Neraca air FAO-56".
WB_ENABLED=1
WB_RECOMPUTE_H=48
WB_CORRECT_EVERY_H=6
WB_SETTLE_H=2
WB_RAIN_SKIP_MM=10
WB_DEFAULT_LAT=-6.595
WB_DEFAULT_LNG=106.8166

# Arsip cuaca Open-Meteo (v12). Lihat README bagian "Arsip cuaca untuk ML".
WX_FORECAST_ENABLED=1
WX_OBSERVED_ENABLED=1
WX_OBSERVED_DAYS=10
WX_HTTP_TIMEOUT_S=15
WX_HTTP_ATTEMPTS=3
WX_HTTP_BACKOFF_S=1

# JANGAN isi DATABASE_ADMIN_URL di sini. CLI token memintanya lewat prompt.

# Random Forest irigasi. Lihat README bagian "RF: shadow mode dan active mode".
# off = mati | shadow = hanya mencatat (decision_layer='rf', tidak menyiram)
# active = dipakai di aturan R4 kalau reliable (decision_layer='fao56+rf')
RF_MODE=off
# Path DI DALAM container (docker-compose me-mount ./models ke /srv/models, read-only).
RF_MODEL_PATH=/srv/models/smile_irigasi_gabungan_forecast_model.joblib
# id baris model_registries (docs/rf_shadow_model_registry.sql)
RF_MODEL_ID=
RF_ERROR_THRESHOLD_PCT=25
